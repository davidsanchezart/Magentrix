    public class ResponseObject
    {
        public string Message { get; set; }
        public bool Success { get; set; }
        public List<Account> Accounts { get; set; }
    }
    
    public class ContactResponseObject
    {
        public bool Success { get; set; }
        public Contact Contact { get; set; }
    }
    
}